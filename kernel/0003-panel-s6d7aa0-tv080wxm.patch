+/*
+ * Вариант BOE TV080WXM (контроллер S6D7AA0X11) — Samsung Galaxy Tab A 8.0
+ * (2017), SM-T380/SM-T385. Последовательность включения и тайминги взяты
+ * из стокового дерева Samsung (ss_dsi_panel_S6D7AA0X11_TV080WXM_WXGA).
+ */
+static void s6d7aa0_tv080wxm_init(struct s6d7aa0 *ctx,
+				  struct mipi_dsi_multi_context *dsi_ctx)
+{
+	mipi_dsi_usleep_range(dsi_ctx, 20000, 25000);
+
+	s6d7aa0_lock(ctx, dsi_ctx, false);
+
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MCS_OTP_RELOAD, 0x00, 0x10);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MCS_BL_CTL, 0xc7, 0x00, 0x29);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xb3, 0x51);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY,
+				     0x24);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, MIPI_DCS_SET_DISPLAY_BRIGHTNESS,
+				     0x7f);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xc1, 0x01);
+	mipi_dsi_dcs_write_seq_multi(dsi_ctx, 0xf2,
+				     0x02, 0x28, 0x1c, 0x98, 0x24);
+
+	mipi_dsi_usleep_range(dsi_ctx, 10000, 11000);
+
+	mipi_dsi_dcs_exit_sleep_mode_multi(dsi_ctx);
+	mipi_dsi_msleep(dsi_ctx, 120);
+
+	s6d7aa0_lock(ctx, dsi_ctx, true);
+}
