+struct s5k4h5 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *mclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(s5k4h5_supply_names)];
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+
+	struct v4l2_ctrl_handler ctrls;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *again;
+};
+
+static const s64 s5k4h5_link_freqs[] = {
+	S5K4H5_LINK_FREQ,
+};
+
+static inline struct s5k4h5 *to_s5k4h5(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct s5k4h5, sd);
+}
+
+static int s5k4h5_write_table(struct s5k4h5 *s5k,
+			      const struct s5k_reg *regs, unsigned int len)
+{
+	int ret = 0;
+	unsigned int i;
+
+	for (i = 0; i < len; i++) {
+		cci_write(s5k->regmap, CCI_REG8(regs[i].addr),
+			  regs[i].val, &ret);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int s5k4h5_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h5 *s5k = to_s5k4h5(sd);
+	int ret;
+
+	ret = regulator_bulk_enable(ARRAY_SIZE(s5k->supplies), s5k->supplies);
+	if (ret)
+		return ret;
+
+	usleep_range(1000, 1500);
+
+	ret = clk_prepare_enable(s5k->mclk);
+	if (ret) {
+		regulator_bulk_disable(ARRAY_SIZE(s5k->supplies),
+				       s5k->supplies);
+		return ret;
+	}
+
+	usleep_range(1000, 1500);
+	gpiod_set_value_cansleep(s5k->reset_gpio, 0);	/* отпустить сброс */
+	usleep_range(2000, 2500);
+
+	return 0;
+}
+
+static int s5k4h5_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct s5k4h5 *s5k = to_s5k4h5(sd);
+
+	gpiod_set_value_cansleep(s5k->reset_gpio, 1);
+	clk_disable_unprepare(s5k->mclk);
+	regulator_bulk_disable(ARRAY_SIZE(s5k->supplies), s5k->supplies);
+
+	return 0;
+}
+
+static int s5k4h5_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct s5k4h5 *s5k = container_of(ctrl->handler, struct s5k4h5, ctrls);
+	int ret = 0;
+
+	/* Пределы экспозиции следуют за vblank */
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		int max = S5K4H5_HEIGHT + ctrl->val - S5K4H5_EXPOSURE_MARGIN;
+
+		__v4l2_ctrl_modify_range(s5k->exposure, S5K4H5_EXPOSURE_MIN,
+					 max, 1, max);
+	}
+
+	if (pm_runtime_get_if_in_use(s5k->dev) == 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_EXPOSURE:
+		cci_write(s5k->regmap, S5K4H5_REG_EXPOSURE, ctrl->val, &ret);
+		break;
+	case V4L2_CID_ANALOGUE_GAIN:
+		cci_write(s5k->regmap, S5K4H5_REG_ANALOG_GAIN, ctrl->val,
+			  &ret);
+		break;
+	case V4L2_CID_VBLANK:
+		cci_write(s5k->regmap, S5K4H5_REG_VTS,
+			  S5K4H5_HEIGHT + ctrl->val, &ret);
+		break;
+	default:
+		break;
+	}
+
+	pm_runtime_put(s5k->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops s5k4h5_ctrl_ops = {
+	.s_ctrl = s5k4h5_set_ctrl,
+};
+
+static int s5k4h5_start_streaming(struct s5k4h5 *s5k)
+{
+	int ret;
+
+	ret = s5k4h5_write_table(s5k, s5k4h5_capture_setting,
+				 ARRAY_SIZE(s5k4h5_capture_setting));
+	if (ret)
+		return ret;
+
+	ret = __v4l2_ctrl_handler_setup(&s5k->ctrls);
+	if (ret)
+		return ret;
+
+	return cci_write(s5k->regmap, S5K4H5_REG_MODE_SELECT,
+			 S5K4H5_MODE_STREAMING, NULL);
+}
+
+static int s5k4h5_s_stream(struct v4l2_subdev *sd, int enable)
+{
+	struct s5k4h5 *s5k = to_s5k4h5(sd);
+	int ret = 0;
+
+	if (enable) {
+		ret = pm_runtime_resume_and_get(s5k->dev);
+		if (ret)
+			return ret;
+
+		ret = s5k4h5_start_streaming(s5k);
+		if (ret) {
+			pm_runtime_put(s5k->dev);
+			return ret;
+		}
+	} else {
+		cci_write(s5k->regmap, S5K4H5_REG_MODE_SELECT,
+			  S5K4H5_MODE_STANDBY, NULL);
+		pm_runtime_put(s5k->dev);
+	}
+
+	return ret;
+}
+
+static int s5k4h5_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	if (code->index)
+		return -EINVAL;
+	code->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	return 0;
+}
+
+static void s5k4h5_update_fmt(struct v4l2_mbus_framefmt *fmt)
+{
+	fmt->width = S5K4H5_WIDTH;
+	fmt->height = S5K4H5_HEIGHT;
+	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
+	fmt->field = V4L2_FIELD_NONE;
+	fmt->colorspace = V4L2_COLORSPACE_RAW;
+	fmt->quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->xfer_func = V4L2_XFER_FUNC_NONE;
+}
+
+static int s5k4h5_set_fmt(struct v4l2_subdev *sd,
+			  struct v4l2_subdev_state *state,
+			  struct v4l2_subdev_format *fmt)
+{
+	s5k4h5_update_fmt(&fmt->format);
+	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+	return 0;
+}
+
+static int s5k4h5_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	s5k4h5_update_fmt(v4l2_subdev_state_get_format(state, 0));
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops s5k4h5_video_ops = {
+	.s_stream = s5k4h5_s_stream,
+};
+
+static const struct v4l2_subdev_pad_ops s5k4h5_pad_ops = {
+	.enum_mbus_code = s5k4h5_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = s5k4h5_set_fmt,
+};
+
+static const struct v4l2_subdev_ops s5k4h5_subdev_ops = {
+	.video = &s5k4h5_video_ops,
+	.pad = &s5k4h5_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops s5k4h5_internal_ops = {
+	.init_state = s5k4h5_init_state,
+};
+
+static int s5k4h5_init_controls(struct s5k4h5 *s5k)
+{
+	struct v4l2_ctrl_handler *hdl = &s5k->ctrls;
+	int exp_max = S5K4H5_FLL - S5K4H5_EXPOSURE_MARGIN;
+	int ret;
+
+	ret = v4l2_ctrl_handler_init(hdl, 6);
+	if (ret)
+		return ret;
+
+	s5k->pixel_rate = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_PIXEL_RATE,
+					    S5K4H5_PIXEL_RATE,
+					    S5K4H5_PIXEL_RATE, 1,
+					    S5K4H5_PIXEL_RATE);
+	s5k->link_freq = v4l2_ctrl_new_int_menu(hdl, NULL, V4L2_CID_LINK_FREQ,
+						0, 0, s5k4h5_link_freqs);
+	if (s5k->link_freq)
+		s5k->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k->hblank = v4l2_ctrl_new_std(hdl, NULL, V4L2_CID_HBLANK,
+					S5K4H5_LLP - S5K4H5_WIDTH,
+					S5K4H5_LLP - S5K4H5_WIDTH, 1,
+					S5K4H5_LLP - S5K4H5_WIDTH);
+	if (s5k->hblank)
+		s5k->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	s5k->vblank = v4l2_ctrl_new_std(hdl, &s5k4h5_ctrl_ops,
+					V4L2_CID_VBLANK,
+					S5K4H5_FLL - S5K4H5_HEIGHT,
+					0xffff - S5K4H5_HEIGHT, 1,
+					S5K4H5_FLL - S5K4H5_HEIGHT);
+	s5k->exposure = v4l2_ctrl_new_std(hdl, &s5k4h5_ctrl_ops,
+					  V4L2_CID_EXPOSURE,
+					  S5K4H5_EXPOSURE_MIN, exp_max, 1,
+					  exp_max);
+	s5k->again = v4l2_ctrl_new_std(hdl, &s5k4h5_ctrl_ops,
+				       V4L2_CID_ANALOGUE_GAIN,
+				       S5K4H5_ANA_GAIN_MIN,
+				       S5K4H5_ANA_GAIN_MAX, 1,
+				       S5K4H5_ANA_GAIN_DEFAULT);
+
+	if (hdl->error) {
+		ret = hdl->error;
+		v4l2_ctrl_handler_free(hdl);
+		return ret;
+	}
+
+	s5k->sd.ctrl_handler = hdl;
+	return 0;
+}
+
+static int s5k4h5_identify(struct s5k4h5 *s5k)
+{
+	u64 chip_id;
+	int ret;
+
+	ret = cci_read(s5k->regmap, S5K4H5_REG_CHIP_ID, &chip_id, NULL);
+	if (ret)
+		return dev_err_probe(s5k->dev, ret, "нет ответа сенсора\n");
+
+	if (chip_id != S5K4H5_CHIP_ID) {
+		dev_err(s5k->dev, "неожиданный chip id %#llx\n", chip_id);
+		return -ENODEV;
+	}
+
+	dev_info(s5k->dev, "Samsung S5K4H5 (id %#llx)\n", chip_id);
+	return 0;
+}
+
+static int s5k4h5_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct s5k4h5 *s5k;
+	unsigned int i;
+	int ret;
+
+	s5k = devm_kzalloc(dev, sizeof(*s5k), GFP_KERNEL);
+	if (!s5k)
+		return -ENOMEM;
+
+	s5k->dev = dev;
+
+	s5k->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(s5k->regmap))
+		return PTR_ERR(s5k->regmap);
+
+	s5k->mclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(s5k->mclk))
+		return dev_err_probe(dev, PTR_ERR(s5k->mclk), "нет mclk\n");
+
+	ret = clk_set_rate(s5k->mclk, S5K4H5_MCLK_RATE);
+	if (ret)
+		return dev_err_probe(dev, ret, "mclk 24 МГц не ставится\n");
+
+	for (i = 0; i < ARRAY_SIZE(s5k4h5_supply_names); i++)
+		s5k->supplies[i].supply = s5k4h5_supply_names[i];
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(s5k->supplies),
+				      s5k->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "нет питания\n");
+
+	s5k->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(s5k->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(s5k->reset_gpio),
+				     "нет reset-gpio\n");
+
+	v4l2_i2c_subdev_init(&s5k->sd, client, &s5k4h5_subdev_ops);
+	s5k->sd.internal_ops = &s5k4h5_internal_ops;
+	s5k->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	s5k->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+
+	ret = s5k4h5_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = s5k4h5_identify(s5k);
+	if (ret)
+		goto err_power;
+
+	ret = s5k4h5_init_controls(s5k);
+	if (ret)
+		goto err_power;
+
+	s5k->pad.flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&s5k->sd.entity, 1, &s5k->pad);
+	if (ret)
+		goto err_ctrls;
+
+	ret = v4l2_subdev_init_finalize(&s5k->sd);
+	if (ret)
+		goto err_media;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_idle(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&s5k->sd);
+	if (ret)
+		goto err_pm;
+
+	return 0;
+
+err_pm:
+	pm_runtime_disable(dev);
+	v4l2_subdev_cleanup(&s5k->sd);
+err_media:
+	media_entity_cleanup(&s5k->sd.entity);
+err_ctrls:
+	v4l2_ctrl_handler_free(&s5k->ctrls);
+err_power:
+	s5k4h5_power_off(dev);
+	return ret;
+}
+
+static void s5k4h5_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct s5k4h5 *s5k = to_s5k4h5(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&s5k->ctrls);
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		s5k4h5_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct dev_pm_ops s5k4h5_pm_ops = {
+	SET_RUNTIME_PM_OPS(s5k4h5_power_off, s5k4h5_power_on, NULL)
+};
+
+static const struct of_device_id s5k4h5_of_match[] = {
+	{ .compatible = "samsung,s5k4h5" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, s5k4h5_of_match);
+
+static struct i2c_driver s5k4h5_i2c_driver = {
+	.driver = {
+		.name = "s5k4h5",
+		.pm = &s5k4h5_pm_ops,
+		.of_match_table = s5k4h5_of_match,
+	},
+	.probe = s5k4h5_probe,
+	.remove = s5k4h5_remove,
+};
+module_i2c_driver(s5k4h5_i2c_driver);
+
+MODULE_DESCRIPTION("Samsung S5K4H5 image sensor driver");
+MODULE_LICENSE("GPL");
