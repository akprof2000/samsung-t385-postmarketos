// SPDX-License-Identifier: GPL-2.0-only
/*
 * Samsung Galaxy Tab A 8.0 (2017) LTE - SM-T385 (gta2slte)
 * postmarketOS mainline device tree
 *
 * Выведен из порта SM-T380 (gta2swifi) авторства sapphicdisaster:
 *   https://github.com/sapphicdisaster/t380-linux
 * Все значения сверены со стоковым DTB, прочитанным с живого SM-T385
 * (Samsung GTA2SLTE PROJECT Rev05, прошивка T385DXS4CUD3).
 *
 * Платы T380 и T385 электрически идентичны: тачскрин, панель, питание
 * SM5703, USB-C PD S2MM005, все шины i2c-gpio и кнопки совпали до
 * номера GPIO. Отличия — SoC ID (MSM8917 против APQ8017), ревизия платы,
 * размер splash-региона и наличие модема.
 */

/dts-v1/;

#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>
#include <dt-bindings/clock/qcom,rpmcc.h>
#include <dt-bindings/power/qcom-rpmpd.h>
#include "msm8917.dtsi"
#include "pm8937.dtsi"
/* dai-link-и звукового тракта: mm1-4, primary/tertiary MI2S */
#include "msm8937-qdsp6.dtsi"

/ {
	    model = "Samsung Galaxy Tab A 8.0 (2017) LTE (SM-T385)";
	
	compatible = "samsung,gta2slte", "qcom,msm8917";
	
	/* MSM8917. У Wi-Fi версии T380 здесь 307 (APQ8017, без модема). */
	qcom,msm-id = <303 0>;
	/* Ревизия платы 05 — снята с живого устройства. */
	qcom,board-id = <0x08 0x05>;

	aliases {
		serial0 = &blsp1_uart2;
        sdhc1 = &sdhc_1;
        sdhc2 = &sdhc_2;
		i2c2 = &blsp1_i2c2;
		i2c3 = &blsp1_i2c3;
		i2c4 = &blsp1_i2c4;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default", "sleep";
		pinctrl-0 = <&gpio_keys_default>;
		pinctrl-1 = <&gpio_keys_sleep>;

		event-hall-sensor {
			/* Датчик Холла чехла (сток: hall,gpio_flip_cover GPIO46,
			 * подтяжка вверх). Открыт = 1, закрыт (магнит) = 0 —
			 * проверено на живом устройстве. */
			label = "Hall Effect Sensor";
			gpios = <&tlmm 46 GPIO_ACTIVE_LOW>;
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;
			linux,can-disable;
			wakeup-source;
		};

		home {
			label = "Home";
			gpios = <&tlmm 128 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_HOMEPAGE>;
			wakeup-source;
			debounce-interval = <15>;
		};

		volume-up {
			label = "Volume Up";
			gpios = <&tlmm 127 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_VOLUMEUP>;
			debounce-interval = <15>;
		};
	};

	sm5703_battery: battery {
		compatible = "simple-battery";
		charge-full-design-microamp-hours = <5000000>;
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4400000>;
		constant-charge-current-max-microamp = <2000000>;
		constant-charge-voltage-max-microvolt = <4400000>;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		                framebuffer0: framebuffer@a80006a8 {
			compatible = "simple-framebuffer";
			/*
			 * Кадровый буфер, оставленный загрузчиком lk2nd.
			 *
			 * Формат в доноре указан как "g8b8r8" — такого имени
			 * ядро не знает: в SIMPLEFB_FORMATS (include/linux/
			 * platform_data/simplefb.h) при 24 битах есть только
			 * "r8g8b8". При неизвестном имени simpledrm отвергает
			 * узел с -EINVAL. Шаг 2400 = 800*3 подтверждает 24 бита.
			 *
			 * Обслуживает узел CONFIG_DRM_SIMPLEDRM; без него
			 * узел не даёт ничего независимо от status.
			 */
			/*
			 * ВКЛЮЧЁН (r54): plymouth рисует сплэш на simpledrm с
			 * ~4-й секунды. Старое падение plymouth (SIGSEGV при
			 * передаче simpledrm -> msm-drm) больше не воспроизводимо:
			 * plymouth завершается на ~11с, msm-drm приходит на ~25с —
			 * пересечения нет. Если краш вернётся — гасить обратно.
			 */
			status = "okay";
			reg = <0x00 0xa80006a8 0x00 0x2ee000>;  /* 800*1280*3 */
			width = <800>;
			height = <1280>;
			stride = <2400>;
			format = "r8g8b8";
			memory-region = <&splash_region>;
		};	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		/* other_ext_region @ 86100000 - Protected by base qseecom node */

		/* smem gap @ 86300000 - Protected by base smem node */

		/* smem gap @ 86300000 (1MB) - Protected by soc smem node */

		/* other_ext_region_post @ 86400000 - Protected by base reserved node */

		ramoops@af980000 {
			compatible = "ramoops";
			reg = <0x00 0xaf980000 0x00 0x80000>;
			record-size = <0x20000>;
			console-size = <0x20000>;
			no-map;
		};

		shield_gap1: shield@85a00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x85a00000 0x00 0x100000>;
		};

		/* qseecom_mem @ 85b00000 - Protected by base DTSI node */

		tzapp_region@84500000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x84500000 0x00 0xb00000>;
		};

		/*
		 * Область прошивки модема описана ниже через &mpss_mem
		 * (0x86800000, 0x5a00000 — стоковый размер T385): прежняя
		 * защитная заглушка modem_region превратилась в рабочий
		 * резерв remoteproc-а модема.
		 */

		/*
		 * Область прошивки ADSP описана ниже через &adsp_mem: прежняя
		 * защитная заглушка removed-dma-pool занимала это же место
		 * и не давала звуковому сопроцессору подняться.
		 */

		wcnss_fw_region: wcnss_fw_region@8da00000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8da00000 0x00 0x700000>;
		};

		/* Первый мегабайт бывшего щита отдан под mba_mem (см. ниже) */
		shield_gap2: shield@8e200000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8e200000 0x00 0x1400000>;
		};

		/*
		 * Область видеодекодера venus описана ниже через &venus_mem:
		 * прежняя защитная заглушка removed-dma-pool занимала это же
		 * место и не давала декодеру получить память ("failed to
		 * lookup reserved memory-region").
		 */

		shield_gap3: shield@8f900000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x8f900000 0x00 0x300000>;
		};

		shield_gap4_pre: shield@90000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x90000000 0x00 0x2100000>;
		};

		/* rmtfs @ 92100000 - Protected by base node */

		shield_gap4_post: shield@92280000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x92280000 0x00 0x0d80000>;
		};

		secure_region {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x7000000>;
		};

		/* Disabled due to memory danger zone concerns
		qseecom_region {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
		};
		*/

		adsp_region {
			compatible = "shared-dma-pool";
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x400000>;
		};

		splash_reserved: splash_reserved@a8000000 {
			reg = <0x00 0xa8000000 0x00 0x1000>;
			no-map;
		};

		splash_region: splash_region@a8001000 {
			/* У T385 стоковый splash = 0xa8000000 + 0x300000 (3 МБ),
			   у T380 было 4 МБ. Первая страница отдана под splash_reserved. */
			reg = <0x00 0xa8001000 0x00 0x2ff000>;
			iommu-addresses = <&apps_iommu 0x15 0x00 0xa8001000 0x00 0x400000>;
			no-map;
		};

		/* Disabled due to memory danger zone concerns
		ss_plog@85c00000 {
			compatible = "ss_plog";
			no-map;
			reg = <0x00 0x85c00000 0x00 0x400000>;
		};
		*/

		lk_region@8f600000 {
			no-map;
			reg = <0x00 0x8f600000 0x00 0x300000>;
		};

		modem_shared_mem_region@93000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x93000000 0x00 0x6000000>;
		};

		/* The Great Shield (Pre): Protects Danger Zone up to Splash (0x99000000 - 0xa8000000) */
		danger_zone_pre: danger_zone_pre@99000000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0x99000000 0x00 0x0f000000>;
		};

		/* Щит после splash: закрывает 0xa8300000 .. 0xaf980000 (до ramoops) */
		danger_zone_post: danger_zone_post@a8300000 {
			compatible = "removed-dma-pool";
			no-map;
			reg = <0x00 0xa8300000 0x00 0x07680000>;
		};
	};

	reg_cam_vana: regulator-cam-vana {
		compatible = "regulator-fixed";
		regulator-name = "cam_vana";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		/* Проверено: ключ ВЫСОКИМ (с низким поток умирает) */
		gpio = <&tlmm 88 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_cam_vdig: regulator-cam-vdig {
		compatible = "regulator-fixed";
		regulator-name = "cam_vdig";
		regulator-min-microvolt = <1200000>;
		regulator-max-microvolt = <1200000>;
		gpio = <&tlmm 89 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	reg_cam_vio: regulator-cam-vio {
		compatible = "regulator-fixed";
		regulator-name = "cam_vio";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		gpio = <&tlmm 39 GPIO_ACTIVE_HIGH>;
		enable-active-high;
	};

	/*
	 * Питание смещения микрофонов. В стоковом дереве это отдельные
	 * выводы: qcom,mainmic-bias-gpio = <&tlmm 68>, submic — <&tlmm 99>.
	 * Без них аналоговые микрофоны молчат: кодек честно включает AMIC1,
	 * ADC1 и своё внутреннее смещение, но на сам микрофон питание не
	 * приходит, и в записи только шум. Проверено замером: без смещения
	 * уровень сигнала ~7, с ним ~150.
	 *
	 * Держим включёнными постоянно: расход — доли миллиампера, а
	 * привязать их к включению тракта в mainline-драйвере кодека
	 * (msm8916-wcd-analog) нечем — внешнего смещения он не знает.
	 */
	reg_mic_bias_main: regulator-mic-bias-main {
		compatible = "regulator-fixed";
		regulator-name = "mic_bias_main";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 68 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	reg_mic_bias_sub: regulator-mic-bias-sub {
		compatible = "regulator-fixed";
		regulator-name = "mic_bias_sub";
		regulator-min-microvolt = <2800000>;
		regulator-max-microvolt = <2800000>;
		gpio = <&tlmm 99 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
	};

	reg_vbus_fixed: regulator-vbus-fixed {
		compatible = "regulator-fixed";
		regulator-name = "vbus_fixed";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		regulator-always-on;
		regulator-boot-on;
	};

	tlmm94_vreg: tlmm94_vreg {
		compatible = "regulator-fixed";
		regulator-name = "tlmm94_vreg";
		gpio = <&tlmm 94 0>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	pericom_en: pericom_en {
		compatible = "regulator-fixed";
		regulator-name = "pericom_en";
		gpio = <&tlmm 131 1>; /* GPIO_ACTIVE_LOW */
		enable-active-low;
		regulator-boot-on;
		regulator-always-on;
	};

	usb_hub_en: usb_hub_en {
		compatible = "regulator-fixed";
		regulator-name = "usb_hub_en";
		gpio = <&tlmm 100 0>; /* GPIO_ACTIVE_HIGH */
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	eldo2: eldo2 {
		compatible = "regulator-fixed";
		regulator-name = "eldo2";
		gpio = <&pm8937_gpios 7 0>;
		regulator-min-microvolt = <2900000>;
		regulator-max-microvolt = <2900000>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	tsp_io: tsp_io {
		compatible = "regulator-fixed";
		regulator-name = "tsp_io";
		gpio = <&tlmm 91 0>;
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	tsp_avdd: tsp_avdd {
		compatible = "regulator-fixed";
		regulator-name = "tsp_avdd";
		gpio = <&tlmm 92 0>;
		regulator-min-microvolt = <3000000>;
		regulator-max-microvolt = <3000000>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	lcd_vddlcd: lcd-vddlcd {
		/*
		 * Питание цепей смещения матрицы (в стоке msmgpio8_vreg).
		 * Всегда включено, как и в стоке: панель без него не светится.
		 */
		compatible = "regulator-fixed";
		regulator-name = "lcd_vddlcd";
		gpio = <&tlmm 8 0>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	lcd_vsp: lcd-vsp {
		/* Второе смещение матрицы (в стоке msmgpio87_vreg). */
		compatible = "regulator-fixed";
		regulator-name = "lcd_vsp";
		gpio = <&tlmm 87 0>;
		enable-active-high;
		regulator-boot-on;
		regulator-always-on;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	i2c_11: i2c-11 {
		status = "disabled";
	};

	i2c_22: i2c-22 {
		compatible = "i2c-gpio";
		gpios = <&tlmm 20 0 &tlmm 21 0>; /* SDA = 20, SCL = 21 */
		i2c-gpio,delay-us = <10>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_22_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		accelerometer@1d {
			compatible = "st,lis2hh12";
			reg = <0x1d>;
			interrupt-parent = <&tlmm>;
			interrupts = <42 IRQ_TYPE_EDGE_RISING>;
			/*
			 * Датчик установлен на плате с разворотом на 180°
			 * относительно экрана: без матрицы phosh поворачивал
			 * изображение вверх ногами. Инвертируем X и Y.
			 */
			mount-matrix = "-1", "0", "0",
				       "0", "-1", "0",
				       "0", "0", "1";
		};
	};

	sec-debug {
		crash_key {
			keys = <0x72 0x74 0x74>;
			size-keys = <0x03>;
			timeout = <0x3e8>;
			function = "keycrash";
		};
	};

	input_booster {
		status = "okay";
		compatible = "input_booster";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		booster_key_1 {
			input_booster,label = "KEY";
			input_booster,type = <0x00>;
			input_booster,levels = <0x01>;
			input_booster,cpu_freqs = <0x10b300>;
			input_booster,hmp_boost = <0x01>;
			input_booster,bimc_freqs = <0x00>;
			input_booster,head_times = <0x1f4>;
			input_booster,tail_times = <0x1f4>;
		};
		booster_key_2 {
			input_booster,label = "TOUCHKEY";
			input_booster,type = <0x01>;
			input_booster,levels = <0x01>;
			input_booster,cpu_freqs = <0x10b300>;
			input_booster,hmp_boost = <0x00>;
			input_booster,bimc_freqs = <0x00>;
			input_booster,head_times = <0x00>;
			input_booster,tail_times = <0x1f4>;
		};
		booster_key_3 {
			input_booster,label = "TOUCH";
			input_booster,type = <0x02>;
			input_booster,levels = <0x01 0x02 0x03>;
			input_booster,cpu_freqs = <0x130b00 0x130b00 0x10b300>;
			input_booster,hmp_boost = <0x01 0x01 0x00>;
			input_booster,bimc_freqs = <0x00 0x00 0x00>;
			input_booster,head_times = <0xc8 0xc8 0x00>;
			input_booster,tail_times = <0x00 0x00 0x12c>;
		};
		booster_key_4 {
			input_booster,label = "MULTITOUCH";
			input_booster,type = <0x03>;
			input_booster,levels = <0x01 0x02>;
			input_booster,cpu_freqs = <0x1560a8 0x130b00>;
			input_booster,hmp_boost = <0x01 0x01>;
			input_booster,bimc_freqs = <0x00 0x00>;
			input_booster,head_times = <0x12c 0x00>;
			input_booster,tail_times = <0x00 0x2bc>;
		};
		booster_key_6 {
			input_booster,label = "MOUSE";
			input_booster,type = <0x05>;
			input_booster,levels = <0x01 0x02>;
			input_booster,cpu_freqs = <0x130b00 0x10b300>;
			input_booster,hmp_boost = <0x01 0x00>;
			input_booster,bimc_freqs = <0x00 0x00>;
			input_booster,head_times = <0xc8 0x00>;
			input_booster,tail_times = <0x00 0x12c>;
		};
		booster_key_7 {
			input_booster,label = "MOUSE WHEEL";
			input_booster,type = <0x06>;
			input_booster,levels = <0x01 0x02>;
			input_booster,cpu_freqs = <0x130b00 0x00>;
			input_booster,hmp_boost = <0x01 0x00>;
			input_booster,bimc_freqs = <0x00 0x00>;
			input_booster,head_times = <0xc8 0x00>;
			input_booster,tail_times = <0x00 0x00>;
		};
		booster_key_8 {
			input_booster,label = "PEN HOVER";
			input_booster,type = <0x07>;
			input_booster,levels = <0x01 0x02>;
			input_booster,cpu_freqs = <0x130b00 0x10b300>;
			input_booster,hmp_boost = <0x01 0x00>;
			input_booster,bimc_freqs = <0x00 0x00>;
			input_booster,head_times = <0xc8 0x00>;
			input_booster,tail_times = <0x00 0x12c>;
		};
	};

	firmware {
		android {
			compatible = "android,firmware";
			fstab {
				compatible = "android,fstab";
				vendor {
					compatible = "android,vendor";
					dev = "/dev/block/platform/soc/7824900.sdhci/by-name/vendor";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,verify";
					status = "disabled";
				};
				system {
					compatible = "android,system";
					dev = "/dev/block/platform/soc/7824900.sdhci/by-name/system";
					type = "ext4";
					mnt_flags = "ro,barrier=1,discard";
					fsmgr_flags = "wait,verify";
					status = "ok";
				};
			};
		};
	};

	i2c_8: i2c-8 {
		cell-index = <0x08>;
		compatible = "i2c-gpio";
		gpios = <&tlmm 16 0 &tlmm 17 0>;
		i2c-gpio,delay-us = <10>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_8_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		muic: muic@25 {
			compatible = "siliconmitus,sm5703-muic";
			reg = <0x25>;
			interrupt-parent = <&tlmm>;
			interrupts = <28 IRQ_TYPE_EDGE_FALLING>;
			switch-gpios = <&tlmm 40 0>;
		};
	};

	i2c_12: i2c-12 {
		cell-index = <0x0c>;
		compatible = "i2c-gpio";
		gpios = <&tlmm 18 0 &tlmm 19 0>;
		i2c-gpio,delay-us = <10>;
		pinctrl-names = "default";
		pinctrl-0 = <&i2c_12_pins>;
		#address-cells = <1>;
		#size-cells = <0>;

		sm5703mfd@49 {
			compatible = "siliconmitus,sm5703mfd";
			reg = <0x49>;
			/* Фонарик того же чипа. У FLED два пина включения:
			 * GPIO34 = movie/фонарик (ток IMLED, регулируемый),
			 * GPIO33 = вспышка (фиксированный ток IFLED). Для
			 * фонарика нужен именно 34 — проверено: с 33 яркость
			 * не регулируется. Драйвер sm5703-charger (патч 0002). */
			flash-enable-gpios = <&tlmm 34 GPIO_ACTIVE_HIGH>;

			interrupt-parent = <&tlmm>;
			interrupts = <35 IRQ_TYPE_EDGE_FALLING>;
			interrupt-controller;
			#interrupt-cells = <1>;

			regulators {
				compatible = "siliconmitus,sm5703-regulator";
				sm5703_usbldo1: usbldo1 {
					regulator-name = "USBLDO1";
					regulator-always-on;
				};

				sm5703_usbldo2: usbldo2 {
					regulator-name = "USBLDO2";
				};

				sm5703_ldo1: ldo1 {
					regulator-name = "VCC_1.8V_AP";
					regulator-min-microvolt = <1800000>;
					regulator-max-microvolt = <1800000>;
				};

				sm5703_ldo2: ldo2 {
					regulator-name = "VCC_3.0V_AP";
					regulator-min-microvolt = <3000000>;
					regulator-max-microvolt = <3000000>;
				};

				sm5703_ldo3: ldo3 {
					regulator-name = "VCC_2.8V_AP";
					regulator-min-microvolt = <2800000>;
					regulator-max-microvolt = <2800000>;
				};

				sm5703_buck: buck {
					regulator-name = "VCC_1.2V_AP";
					regulator-min-microvolt = <1200000>;
					regulator-max-microvolt = <1200000>;
				};

				sm5703_vbus: vbus {
					regulator-name = "VBUS_BOOST";
					regulator-min-microvolt = <5000000>;
					regulator-max-microvolt = <5000000>;
				};
			};

			charger {
				compatible = "siliconmitus,sm5703-charger";
				monitored-battery = <&sm5703_battery>;
				extcon = <&muic>;
			};
		};
	};

	/*
	 * МОДЕМ ВКЛЮЧЁН (см. &modem внизу файла). У T385 в стоке
	 * qcom,mss@4080000 (qcom,pil-q6v55-mss); mainline-узел —
	 * remoteproc@4080000 (qcom,msm8917-mss-pil). Память: &mpss_mem
	 * по стоковому адресу/размеру, &mba_mem — мегабайт, отрезанный
	 * от щита 0x8e100000. Питание mss/pll — как у msm8917-xiaomi-*
	 * (S1/L7 того же PM8937). Прошивку (mba.mbn, modem.*) отдаёт
	 * msm-firmware-loader со стокового раздела "modem" (vfat).
	 * Сеть — BAM-DMUX (bam_dmux + выделенный DMA), управление —
	 * QMI через QRTR/SMD.
	 */

	soc {
		sec_smem {
			compatible = "samsung,sec-smem";
			status = "okay";
		};
	};
};

&blsp1_uart2 {
	status = "okay";
};

&blsp1_i2c3 {
        status = "okay";
        clock-frequency = <400000>;
        pinctrl-names = "default";
        pinctrl-0 = <&blsp1_i2c3_default>;

        touchscreen@49 {		compatible = "st,stmfts";
		reg = <0x49>;
		interrupt-parent = <&tlmm>;
		interrupts = <65 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&tsp_int_default>;
		vdd-supply = <&tsp_io>;
		avdd-supply = <&tsp_avdd>;
		/*
		 * Линии сброса у этого тачскрина нет.
		 *
		 * reset-gpios достался от донорского дерева, но в стоковом
		 * дереве Samsung (touchscreen@49, compatible "stm,fts_touch")
		 * никакого сброса не описано: только два питания tsp_io и
		 * tsp_avdd и прерывание stm,irq_gpio = <&tlmm 65>. Драйвер
		 * stmfts к линиям ввода-вывода вообще не обращается, так что
		 * свойство было мёртвым.
		 *
		 * Размеры сходятся со стоком: stm,max_coords = <0x640 0xa00>
		 * это 1600 x 2560.
		 */
		touchscreen-size-x = <1600>;
		touchscreen-size-y = <2560>;
		touch-key-connected;
	};
};

&tlmm {
	sdc2_cd_default: sdc2-cd-default-state {
		pins = "gpio67";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	gpio_keys_default: gpio-keys-default-state {
		pins = "gpio46", "gpio127", "gpio128";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	gpio_keys_sleep: gpio-keys-sleep-state {
		pins = "gpio46", "gpio127", "gpio128";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	tsp_int_default: tsp-int-default-state {
		pins = "gpio65", "gpio64";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};





	sdc2_cd_default: sdc2-cd-default-state {
		pins = "gpio67";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	sdc2_cd_sleep: sdc2-cd-sleep-state {
		pins = "gpio67";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	i2c_8_pins: i2c-8-pins {
		pins = "gpio16", "gpio17";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	i2c_11_pins: i2c-11-pins {
		pins = "gpio6", "gpio7";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	i2c_12_pins: i2c-12-pins {
		pins = "gpio18", "gpio19";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	i2c_22_pins: i2c-22-pins {
		pins = "gpio20", "gpio21";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};

	blsp1_i2c4_reset: blsp1-i2c4-reset {
		pins = "gpio14", "gpio15";
		function = "gpio";
		drive-strength = <6>;
		bias-pull-down;
		output-low;
	};
};

&blsp1_i2c4_default {
	pins = "gpio14", "gpio15";
	drive-strength = <2>;
	bias-pull-up;
};

&blsp1_i2c4_sleep {
	pins = "gpio14", "gpio15";
	drive-strength = <2>;
	bias-disable;
};

/*
 * Описания выводов sdc1/sdc2 удалены.
 *
 * Драйвер выводов ругался на каждую запись:
 *   msm8917-pinctrl 1000000.pinctrl: invalid function sdc1 in map table
 *   msm8917-pinctrl 1000000.pinctrl: invalid function sdc2 in map table
 * и загрузка вставала на "sdhci_msm 7864900.mmc: Got CD GPIO".
 *
 * На msm8917 линии карты памяти выделенные и не мультиплексируются,
 * поэтому таких функций в драйвере нет вовсе. Настройка приходила
 * из DTS донора и на этом ядре не применима — контроллер настраивается
 * сам, без явного описания выводов.
 */
&sdhc_1 {
	/*
	 * Питание — как у msm8917-xiaomi-riva и msm8917-huawei-agassi.
	 *
	 * Таблица рабочих точек добавлена здесь, потому что в msm8917.dtsi
	 * её у sdhc_1 нет, а драйвер задаёт частоту только через механизм
	 * OPP: msm_set_clock_rate_for_bus_mode() вызывает
	 * dev_pm_opp_set_rate(), после чего читает clk_get_rate(core_clk).
	 * Без таблицы вызов проходит без ошибки, но частота остаётся нулевой
	 * — в журнале "Setting clock at rate 0 at timing 0", и все команды
	 * с ответом истекают по тайм-ауту (-110), включая CMD1. CMD0 при
	 * этом "успешен", потому что ответа не требует.
	 *
	 * Набор частот взят из стокового дерева Samsung (qcom,clk-rates),
	 * привязка к уровням домена питания — по образцу msm8953.dtsi.
	 * Поля пропускной способности намеренно опущены: у sdhc_1 в msm8917
	 * нет свойства interconnects, задавать для него полосу не по чему.
	 */
	vmmc-supply = <&pm8937_l8>;
	vqmmc-supply = <&pm8937_l5>;
	operating-points-v2 = <&sdhc1_opp_table>;

	status = "okay";

	sdhc1_opp_table: opp-table-sdhc1 {
		compatible = "operating-points-v2";

		/*
		 * Нижние точки обязательны.
		 *
		 * Ядро при опознании карты просит 400 кГц. Если самая низкая
		 * точка таблицы — 25 МГц, запрос округляется вверх к ней же,
		 * а подсистема OPP считает текущей точкой самую нижнюю (когда
		 * clk_get_rate ей ничего внятного не вернул). Цель совпадает с
		 * «текущей», OPP решает, что делать нечего, и частота остаётся
		 * той, что оставил загрузчик, — 384 МГц. По спецификации eMMC
		 * на такой частоте отвечать не обязана: в журнале -110 на всех
		 * командах с ответом и "Failed to initialize a non-removable
		 * card". CMD0 при этом проходит, потому что ответа не требует.
		 *
		 * Набор частот — из ftbl_sdcc1_apps_clk_src драйвера
		 * gcc-msm8917 и qcom,clk-rates стокового дерева Samsung.
		 */
		opp-144000 {
			opp-hz = /bits/ 64 <144000>;
			required-opps = <&rpmpd_opp_low_svs>;
		};

		opp-400000 {
			opp-hz = /bits/ 64 <400000>;
			required-opps = <&rpmpd_opp_low_svs>;
		};

		opp-20000000 {
			opp-hz = /bits/ 64 <20000000>;
			required-opps = <&rpmpd_opp_low_svs>;
		};

		opp-25000000 {
			opp-hz = /bits/ 64 <25000000>;
			required-opps = <&rpmpd_opp_low_svs>;
		};

		opp-50000000 {
			opp-hz = /bits/ 64 <50000000>;
			required-opps = <&rpmpd_opp_svs>;
		};

		opp-100000000 {
			opp-hz = /bits/ 64 <100000000>;
			required-opps = <&rpmpd_opp_svs>;
		};

		opp-192000000 {
			opp-hz = /bits/ 64 <192000000>;
			required-opps = <&rpmpd_opp_nom>;
		};

		opp-384000000 {
			opp-hz = /bits/ 64 <384000000>;
			required-opps = <&rpmpd_opp_nom>;
		};
	};
};

&sdhc_2 {
	/*
	 * Слот microSD. Питание и пин детекта карты (GPIO67) — как в
	 * стоковом дереве; та же связка у msm8917-huawei-agassi.
	 *
	 * Слот долго стоял выключенным: на раннем этапе порта ядро молча
	 * умирало сразу после "Got CD GPIO". Причина была не в слоте, а в
	 * том, что DTB тогда собирался номерами тактовых сигналов от
	 * чужой версии ядра (см. RAZBOR.md) — после исправления слот
	 * работает.
	 */
	cd-gpios = <&tlmm 67 GPIO_ACTIVE_LOW>;
	vmmc-supply = <&pm8937_l11>;
	vqmmc-supply = <&pm8937_l12>;
	pinctrl-0 = <&sdc2_default>, <&sdc2_cd_default>;
	pinctrl-1 = <&sdc2_sleep>, <&sdc2_cd_default>;
	pinctrl-names = "default", "sleep";

	status = "okay";
};

/*
 * Звуковой сопроцессор ADSP. Прошивку (adsp.mdt + adsp.b00..b15) достаёт
 * из стокового раздела служба msm-firmware-loader и подставляет ядру
 * через /run/msm-firmware-loader/target — путь уже прописан initramfs.
 * Без ADSP звукового тракта на msm89x7 нет вовсе: карта строится на
 * потоках q6 (msm8937-qdsp6.dtsi), и "No soundcards found" именно отсюда.
 */
&adsp {
	status = "okay";
};

/*
 * Память ADSP — стоковая область T385 (24 МБ на 0x8c200000). В msm8917.dtsi
 * узел описан динамическим выделением из окна, закрытого у нас защитными
 * областями, поэтому адрес задаём явно.
 */
&adsp_mem {
	reg = <0x0 0x8c200000 0x0 0x1800000>;
	/delete-property/ size;
	/delete-property/ alignment;
	/delete-property/ alloc-ranges;
	status = "okay";
};

&apr {
	status = "okay";
};

/*
 * Память модема: mpss — стоковая область T385 (0x5a00000 на 0x86800000),
 * mba — мегабайт, отрезанный от начала бывшего щита 0x8e100000.
 * В msm8917.dtsi обе описаны динамическим выделением — задаём явно.
 */
&mpss_mem {
	reg = <0x0 0x86800000 0x0 0x5a00000>;
	status = "okay";
};

&mba_mem {
	reg = <0x0 0x8e100000 0x0 0x100000>;
	/delete-property/ size;
	/delete-property/ alignment;
	/delete-property/ alloc-ranges;
	status = "okay";
};

&modem {
	mss-supply = <&pm8937_s1>;
	pll-supply = <&pm8937_l7>;
	status = "okay";
};

/*
 * КАМЕРЫ — этап разведки. CCI (шина управления сенсорами) включена,
 * чтобы опросить чипы и определить модели. Стоковая карта (r05):
 *   тыл (CSI0):  mclk GPIO26, VANA GPIO88, RESET GPIO36, VDIG GPIO89,
 *                VIO GPIO39, VAF = L10 2.8В; актуатор dw9807 @0x18,
 *                EEPROM @0x50; CCI master 0, поворот 90°.
 *   фронт (CSI1): mclk GPIO27, RESET GPIO38, VIO GPIO39 (общий),
 *                VANA = L22 2.8В, VDIG = L23 1.2В; CCI master 0, 270°.
 */
&cci {
	/* Ножки MCLK0/1 (GPIO26/27) муксуются здесь же в cam_mclk */
	pinctrl-0 = <&cci0_default>, <&cci1_default>, <&cam_mclk_default>;
	pinctrl-names = "default";
	/* Без GDSC блок CCI не отвечает (транзакции таймаутятся, пока
	 * camss не начнёт стрим и не включит домен сам) — проверено на
	 * живом устройстве: без этого dw9807 не пробится на загрузке. */
	power-domains = <&gcc VFE0_GDSC>;
	status = "okay";
};

&cci_i2c0 {
	/* Тыловая камера Samsung S5K4H5 (8 Мп), chip ID 0x485B. */
	rear_cam: camera-sensor@37 {
		compatible = "samsung,s5k4h5";
		reg = <0x37>;

		clocks = <&gcc GCC_CAMSS_MCLK0_CLK>;

		reset-gpios = <&tlmm 36 GPIO_ACTIVE_LOW>;

		vana-supply = <&reg_cam_vana>;
		vdig-supply = <&reg_cam_vdig>;
		vio-supply = <&reg_cam_vio>;

		lens-focus = <&rear_cam_focus>;

		orientation = <1>;
		rotation = <90>;

		port {
			rear_cam_ep: endpoint {
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&csiphy0_ep>;
				link-frequencies = /bits/ 64 <346000000>;
			};
		};
	};

	/* Фронтальная камера Samsung S5K5E3 (5 Мп). Опознана по chip ID
	 * 0x5E30 на живом устройстве; питание по стоковой карте r05. */
	front_cam: camera-sensor@10 {
		compatible = "samsung,s5k5e3";
		reg = <0x10>;

		clocks = <&gcc GCC_CAMSS_MCLK1_CLK>;

		/* RESET активен НИЗКИМ уровнем на ножке в терминах gpiod:
		 * физически сенсор работает при высоком — ACTIVE_LOW тут
		 * означает «сброс = 0 на линии» */
		reset-gpios = <&tlmm 38 GPIO_ACTIVE_LOW>;

		vana-supply = <&pm8937_l22>;
		vdig-supply = <&pm8937_l23>;
		vio-supply = <&reg_cam_vio>;

		orientation = <0>;
		rotation = <270>;

		port {
			front_cam_ep: endpoint {
				data-lanes = <0 1>;
				remote-endpoint = <&csiphy1_ep>;
				link-frequencies = /bits/ 64 <448000000>;
			};
		};
	};
};

&cci_i2c1 {
	/* Актуатор автофокуса тыловой камеры (питание VAF = L10,
	 * держится always-on — см. узел l10). EEPROM модуля @0x58
	 * на этой же шине, пока не подключён. */
	rear_cam_focus: dw9807@c {
		compatible = "dongwoon,dw9807-vcm";
		reg = <0x0c>;
		/* От cam_vio (GPIO39) питаются подтяжки шины CCI1 —
		 * без неё I2C к актуатору мёртв (наш патч 0011). */
		vdd-supply = <&reg_cam_vio>;
	};
};

&camss {
	vdda-supply = <&pm8937_l2>;
	status = "okay";

	ports {
		port@0 {
			reg = <0>;

			csiphy0_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&rear_cam_ep>;
			};
		};

		port@1 {
			reg = <1>;

			csiphy1_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0 1>;
				remote-endpoint = <&front_cam_ep>;
			};
		};
	};
};

&tlmm {
	cam_mclk_default: cam-mclk-default-state {
		pins = "gpio26", "gpio27";
		function = "cam_mclk";
		drive-strength = <8>;
		bias-disable;
	};
};

&bam_dmux {
	status = "okay";
};

&bam_dmux_dma {
	/*
	 * В стоковом дереве прерывание A2 BAM объявлено EDGE_RISING;
	 * с LEVEL_HIGH из msm8917.dtsi обработчик не видит события —
	 * передачи DMA никогда не завершаются (данные стоят в очереди
	 * при живом рукопожатии pc/pc-ack).
	 */
	interrupts = <GIC_SPI 162 IRQ_TYPE_EDGE_RISING>;
	status = "okay";
};

&venus {
	status = "okay";
};

/*
 * Память видеодекодера — стоковая область T385 (4 МБ на 0x8fc00000).
 * В msm8917.dtsi узел описан динамическим выделением из окна модема,
 * но у нас всё это окно закрыто защитными областями, поэтому задаём
 * адрес явно.
 */
&venus_mem {
	reg = <0x0 0x8fc00000 0x0 0x400000>;
	/delete-property/ size;
	/delete-property/ alignment;
	/delete-property/ alloc-ranges;
	status = "okay";
};

&gpu {
	/*
	 * Adreno 306 (в маркетинге — 308). Прошивки a300_pfp/a300_pm4
	 * ставятся пакетом linux-firmware-qcom, отрисовщик — freedreno
	 * (msm_dri.so). Без этого узла msm_dpu пишет "no GPU device was
	 * found" и композитору остаётся программная отрисовка.
	 */
	status = "okay";
};

&mdss {
	/*
	 * Дисплейный блок включён: экран работает через драйвер msm
	 * (DRM), а не через кадровый буфер загрузчика. Это даёт
	 * аппаратную отрисовку, управление яркостью и гашение экрана.
	 * При запуске msm сам забирает буфер у simpledrm.
	 */
	status = "okay";
};

&mdss_dsi0_phy {
	status = "okay";
	qcom,dsi-phy-regulator-ldo-mode;
	vdda-supply = <&pm8937_l2>;
	vcca-supply = <&pm8937_l2>;
	vddio-supply = <&pm8937_l6>;
};

&usb_hs_phy {
	status = "okay";
	vdd-supply = <&pm8937_l2>;
	vdda1p8-supply = <&pm8937_l7>;
	vdda3p3-supply = <&pm8937_l13>;
};

&usb {
	status = "okay";

	/*
	 * extcon вернулся.
	 *
	 * Раньше с extcon = <&muic> ядро падало на probe этого узла, и я
	 * его убрал. Причина была не в extcon: DTB собирался деревом ядра
	 * 6.17, тогда как на устройстве работает 7.1.3, и номера тактовых
	 * сигналов разошлись — драйверы трогали чужие сигналы. Сейчас DTB
	 * собран правильным деревом, и MUIC на шине определяется.
	 *
	 * Без extcon контроллер не знает о подключении кабеля и не
	 * подтягивает линию D+, поэтому гаджет создаётся, но компьютер
	 * планшета не видит.
	 *
	 * Роль оставляем периферийной: хозяином шины планшету быть не
	 * нужно, а для OTG потребовался бы ещё регулятор vbus.
	 */
	dr_mode = "peripheral";
	extcon = <&muic>;
	usb-phy = <&usb_hs_phy>;
};

&blsp1_i2c2 {
	status = "okay";

	sm5703-fuelgauge@71 {
		compatible = "siliconmitus,sm5703-fg";
		reg = <0x71>;
		interrupt-parent = <&tlmm>;
		interrupts = <63 IRQ_TYPE_EDGE_FALLING>;
		monitored-battery = <&sm5703_battery>;
		status = "okay";
	};
};

&blsp1_i2c4 {
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-names = "default", "sleep", "hard_reset";
	pinctrl-0 = <&blsp1_i2c4_default>;
	pinctrl-1 = <&blsp1_i2c4_sleep>;
	pinctrl-2 = <&blsp1_i2c4_reset>;

	s2mm005: s2mm005@33 {
		compatible = "samsung,s2mm005";
		reg = <0x33>;
		interrupt-parent = <&tlmm>;
		interrupts = <48 IRQ_TYPE_LEVEL_LOW>;
	};
};
&mdss_dsi0 {

    status = "okay";

    vdda-supply = <&pm8937_l2>;

    vddio-supply = <&pm8937_l6>;

    vdd-supply = <&pm8937_l17>;

    vddlcd-supply = <&pm8937_l15>;

    vsp-supply = <&eldo2>;

    phys = <&mdss_dsi0_phy>;



    dsi_panel: panel@0 {

				/* BOE TV080WXM-WXGA (Controller: Samsung S6D7AA0) */
				/* Ported from legacy/apq8017-samsung-gta2swifi-rev3.dts ss_dsi_panel_S6D7AA0X11_TV080WXM_WXGA */
				compatible = "samsung,s6d7aa0x11-tv080wxm", "lk2nd,panel";
				reg = <0>;

				/*
				 * Питание, которое читает драйвер panel-samsung-s6d7aa0:
				 * "power" — аналоговое 2.85 В (в стоке vdd = pm8917_l17),
				 * "vmipi" — 1.8 В (в стоке vddio = pm8917_l6).
				 * Смещение матрицы (VSP/VSN) держат линии GPIO 8 и 87 —
				 * они описаны отдельными регуляторами ниже по файлу.
				 */
				power-supply = <&pm8937_l17>;
				vmipi-supply = <&pm8937_l6>;

				/* Standard Properties */
				samsung,panel-vendor = "BOE";
				reset-gpios = <&tlmm 60 1>;

				/* DSI Properties */
				qcom,mdss-dsi-panel-name = "ss_dsi_panel_S6D7AA0X11_TV080WXM_WXGA";
				qcom,mdss-dsi-panel-type = "dsi_video_mode";
				qcom,mdss-dsi-panel-destination = "display_1";
				qcom,cont-splash-enabled;
				qcom,mdss-dsi-panel-framerate = <60>;
				qcom,mdss-dsi-virtual-channel-id = <0>;
				qcom,mdss-dsi-stream = <0>;
							                            qcom,mdss-dsi-panel-width = <800>;
							                                                    qcom,mdss-dsi-panel-height = <1280>;				
				qcom,mdss-dsi-h-pulse-width = <8>;
				qcom,mdss-dsi-h-back-porch = <144>;
				qcom,mdss-dsi-h-front-porch = <36>;
				qcom,mdss-dsi-h-sync-skew = <0>;
				qcom,mdss-dsi-v-pulse-width = <12>;
				qcom,mdss-dsi-v-back-porch = <28>;
				qcom,mdss-dsi-v-front-porch = <28>;
				qcom,mdss-dsi-h-left-border = <0>;
				qcom,mdss-dsi-h-right-border = <0>;
				qcom,mdss-dsi-v-top-border = <0>;
				qcom,mdss-dsi-v-bottom-border = <0>;
				qcom,mdss-dsi-bpp = <24>;
				qcom,mdss-dsi-underflow-color = <0xff>;
				qcom,mdss-dsi-border-color = <0>;
				qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
				qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
				qcom,mdss-dsi-h-sync-pulse = <0>;
				qcom,mdss-dsi-bllp-eof-power-mode;
				qcom,mdss-dsi-bllp-power-mode;
				qcom,mdss-dsi-panel-timings = <0x871e1400 0x42461828 0x25030400>;
				qcom,mdss-dsi-t-clk-post = <0x04>;
				qcom,mdss-dsi-t-clk-pre = <0x1b>;
				qcom,mdss-dsi-bl-min-level = <1>;
				qcom,mdss-dsi-bl-max-level = <255>;
				qcom,mdss-brightness-max-level = <255>;
				qcom,mdss-dsi-dma-trigger = "trigger_sw";
				qcom,mdss-dsi-mdp-trigger = "none";
				qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_dcs";
				qcom,mdss-dsi-reset-sequence = <1 5 0 1 1 20>;
				qcom,mdss-pan-physical-width-dimension = <108>;
				qcom,mdss-pan-physical-height-dimension = <172>;
				qcom,mdss-dsi-lp11-init;
				qcom,mdss-dsi-init-delay-us = <20000>;
				qcom,mdss-dsi-force-clock-lane-hs;
				qcom,mdss-dsi-traffic-mode = "burst_mode";

				/* Init Commands */
				qcom,mdss-dsi-on-command = [39 01 00 00 00 00 03 f0 5a 5a 39 01 00 00 00 00 03 f1 5a 5a 39 01 00 00 00 00 03 fc a5 a5 39 01 00 00 00 00 03 d0 00 10 39 01 00 00 00 00 04 c3 c7 00 29 39 01 00 00 00 00 02 b3 51 39 01 00 00 00 00 02 53 24 39 01 00 00 00 00 02 51 7f 39 01 00 00 00 00 02 c1 01 39 01 00 00 0a 00 06 f2 02 28 1c 98 24 05 01 00 00 78 00 02 11 00 39 01 00 00 00 00 03 f0 a5 a5 39 01 00 00 00 00 03 f1 a5 a5 39 01 00 00 00 00 03 fc 5a 5a];
				qcom,mdss-dsi-off-command = [05 01 00 00 00 00 02 28 00 05 01 00 00 82 00 02 10 00];
				
				port {
					panel_in: endpoint {
						remote-endpoint = <&mdss_dsi0_out>;
					};
				};
			};


};

&mdss_dsi0_out {
    remote-endpoint = <&panel_in>;
    data-lanes = <0 1 2 3>;
};

