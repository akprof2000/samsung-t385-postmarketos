		};
		pm8937_l5: l5 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
			regulator-boot-on;
		};
		pm8937_l6: l6 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
			regulator-boot-on;
		};
		pm8937_l7: l7 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
			regulator-boot-on;
		};
		pm8937_l8: l8 {
			regulator-min-microvolt = <2850000>;
			regulator-max-microvolt = <2900000>;
		};
		pm8937_l3: l3 {
			regulator-min-microvolt = <1000000>;
			regulator-max-microvolt = <1225000>;
		};
		pm8937_l9: l9 {
			regulator-min-microvolt = <3000000>;
			regulator-max-microvolt = <3300000>;
		};
		pm8937_l10: l10 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <3000000>;
			/* VAF тыловой камеры: EEPROM и актуатор dw9807.
			 * Драйвер dw9807-vcm этого ядра не берёт vdd-supply,
			 * поэтому держим рельсу включённой постоянно. */
			regulator-always-on;
		};
		pm8937_l11: l11 {
			regulator-min-microvolt = <2950000>;
			regulator-max-microvolt = <2950000>;
		};
		pm8937_l12: l12 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <2950000>;
		};
		pm8937_l13: l13 {
			regulator-min-microvolt = <3075000>;
			regulator-max-microvolt = <3075000>;
			regulator-always-on;
			regulator-boot-on;
		};
		pm8937_l14: l14 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
		};
		pm8937_l15: l15 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
			regulator-always-on;
			regulator-boot-on;
		};
		pm8937_l16: l16 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
		pm8937_l17: l17 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2900000>;
		};
		pm8937_l19: l19 {
			regulator-min-microvolt = <1225000>;
			regulator-max-microvolt = <1350000>;
		};
		pm8937_l22: l22 {
			regulator-min-microvolt = <2800000>;
			regulator-max-microvolt = <2800000>;
		};
		pm8937_l23: l23 {
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
		};
	};
};

&soc {

        sec_smem@0 {

                compatible = "samsung,sec-smem";

                status = "okay";

        };

};



&sleep_clk {

	clock-frequency = <32768>;

};



#include "gta2slte_wcnss_pronto.dtsi"

&xo_board {
        clock-frequency = <19200000>;
};

&pm8937_resin {
	status = "okay";
	linux,code = <KEY_VOLUMEDOWN>;
};

&pm8937_pwrkey {
	status = "okay";
};

/* =========================================================================
 * ЗВУК — Samsung SM-T385 (gta2slte)
 *
 * В порте-доноре T380 аудио помечено как незавершённое («ASoC/ALSA DTS
 * bindings drafted, not yet verified»). Здесь оно доведено на основе
 * разбора СТОКОВОГО DTS живого T385.
 *
 * Что даёт сток:
 *   sound { compatible = "qcom,msm8952-audio-codec"; status = "okay"; }
 *   asoc-codec-names = "msm-stub-codec.1", "cajon_codec"
 *       -> "cajon" = внутренний кодек msm8x16_wcd в PMIC PM8937.
 *          В mainline он разложен на две половины:
 *            аналоговая  -> &wcd_codec   (qcom,pm8916-wcd-analog-codec)
 *            цифровая    -> &lpass_codec (qcom,msm8916-wcd-digital-codec)
 *   qcom,msm-mclk-freq = <9600000>
 *   qcom,msm-hs-micbias-type = "internal"
 *   qcom,msm-micbias1-ext-cap, qcom,msm-micbias2-ext-cap
 *   qcom,audio-routing: AMIC1 = Handset Mic, AMIC2 = Secondary Mic,
 *                       AMIC3 = Headset Mic
 *   qcom,mainmic-bias-gpio = <&tlmm 68 0>
 *   qcom,submic-bias-gpio  = <&tlmm 99 0>
 *   sec_jack: detect-gpio = <&tlmm 61 0>, key-gpio = <&tlmm 93 0>
 *
 * Чего в стоке НЕТ (проверено, а не предположено):
 *   - усилителя динамика на I2C: перебор всех compatible по tfa/tas2/max98/
 *     aw87/nxp дал пусто;
 *   - GPIO включения усилителя. Единственный похожий, spkr-sd-n-gpio на
 *     GPIO 96, принадлежит узлу qcom,wsa881x внутри ветки sound-9335,
 *     а она status = "disabled" — это вариант платы с кодеком WCD9335,
 *     не наш.
 *   Остаётся qcom,msm-ext-pa = "primary": динамик висит на primary MI2S
 *   (SCK gpio85, SD0 gpio86, WS gpio87, SD1 gpio88, MCLK gpio25/69)
 *   через усилитель без управляющей шины.
 *
 * Поэтому здесь включён путь, который полностью определён железом и
 * проверяем: наушники и микрофоны через внутренний кодек. Динамик
 * оставлен отдельным блоком ниже — его нужно подтвердить на устройстве,
 * гадать про усилитель я не стал.
 * ========================================================================= */

&lpass_codec {
	status = "okay";
};

&wcd_codec {
	/*
	 * Пороги MBHC определяют, как кодек различает вставленную гарнитуру
	 * и нажатия её кнопок. Взяты типовые для msm8917 с внутренним
	 * micbias — сток задаёт зоны своим драйвером sec_jack
	 * (det-zones-list / but-zones-list), в mainline это делает MBHC.
	 * При неверном срабатывании кнопок правятся именно эти два ряда.
	 */
	qcom,mbhc-vthreshold-low = <75 150 237 450 500>;
	qcom,mbhc-vthreshold-high = <75 150 237 450 500>;

	/* В стоке: qcom,msm-hs-micbias-type = "internal" */
	qcom,hphl-jack-type-normally-open;

	/* qcom,msm-micbias1-ext-cap в стоке */
	qcom,micbias1-ext-cap;
	/* qcom,msm-micbias2-ext-cap в стоке */
	qcom,micbias2-ext-cap;

	vdd-cdc-io-supply = <&pm8937_l5>;
	vdd-cdc-tx-rx-cx-supply = <&pm8937_s4>;
	vdd-micbias-supply = <&pm8937_l13>;

	status = "okay";
};

&sound {
	model = "samsung-gta2slte";

	/*
	 * Маршрутизация повторяет стоковую qcom,audio-routing:
	 *   AMIC1 = Handset Mic (основной микрофон)
	 *   AMIC2 = Secondary Mic (второй микрофон)
	 *   AMIC3 = Headset Mic (микрофон гарнитуры)
	 * MM_DL/MM_UL — потоки к ADSP, как у остальных msm8917 в mainline.
	 */
	widgets =
		"Speaker", "Speaker",
		"Headphone", "Headphones",
		"Microphone", "Handset Mic",
		"Microphone", "Secondary Mic",
		"Microphone", "Headset Mic";

	pin-switches = "Speaker", "Headphones";

	/*
	 * Динамик ведёт внешний усилитель, снимающий сигнал с LINEOUT
	 * кодека (тракт добавлен нашим патчем 0005): в стоковой
	 * маршрутизации усилитель управляется без шины (LINEOUT PA его и питает сигналом).
	 *
	 * Выходы наушников у драйвера msm8916-wcd-analog называются
	 * HPH_L/HPH_R (с подчёркиванием) — с донорскими именами HPHL/HPHR
	 * маршрут не собирался, и наушники молчали бы.
	 */
	audio-routing =
		"Speaker", "SPK_OUT",
		"Headphones", "HPH_L",
		"Headphones", "HPH_R",
		"AMIC1", "MIC BIAS External1",
		"Handset Mic", "MIC BIAS External1",
		"AMIC2", "MIC BIAS Internal2",
		"Headset Mic", "MIC BIAS Internal2",
		"AMIC3", "MIC BIAS External1",
		"Secondary Mic", "MIC BIAS External1",
		"MM_DL1", "MultiMedia1 Playback",
		"MM_DL3", "MultiMedia3 Playback",
		"MM_DL4", "MultiMedia4 Playback",
		"MultiMedia2 Capture", "MM_UL2";

	status = "okay";
};

/*
 * ДИНАМИК — не включён намеренно.
 *
 * Сток говорит qcom,msm-ext-pa = "primary", то есть динамик подключён
 * через внешний усилитель на primary MI2S. Ни I2C-устройства усилителя,
 * ни GPIO его включения в стоковом DTS нет (см. разбор выше), поэтому
 * тип усилителя по дереву не определяется.
 *
 * Чтобы поднять динамик, нужно на живом устройстве выяснить, чем он
 * управляется. Порядок проверки:
 *   1. Загрузиться с этим DTS, убедиться что наушники и микрофоны живы.
 *   2. Посмотреть, звучит ли динамик сам по себе при выводе на
 *      primary MI2S (усилитель может быть always-on):
 *        speaker-test -D hw:0 -c 2 -t sine
 *   3. Если нет — перебрать подозрительные GPIO через libgpiod:
 *        gpioset gpiochip0 <N>=1
 *      и повторить проверку. Кандидаты ищутся среди свободных линий
 *      tlmm, не занятых другими узлами.
 *   4. Когда линия найдена — раскомментировать блок ниже, подставив
 *      номер, и добавить speaker_amp в aux-devs узла &sound.
 *
 * speaker_amp: audio-amplifier {
 *	compatible = "simple-audio-amplifier";
 *	enable-gpios = <&tlmm НОМЕР GPIO_ACTIVE_HIGH>;
 *	sound-name-prefix = "Speaker Amp";
 * };
 *
 * И в &sound:
 *	aux-devs = <&speaker_amp>;
 *	widgets = "Speaker", "Speaker";
 *	audio-routing = "Speaker", "Speaker Amp OUT",
 *			"Speaker Amp IN", "HPHR";
 */

/*
 * DMA-контроллеры BLSP отключены.
 *
 * Ядро падало на них:
 *   Internal error: synchronous external abort: 0000000096000010
 *   pc : bam_dma_probe+0x1d8/0x554
 *   Tainted: [M]=MACHINE_CHECK
 *
 * "Synchronous external abort" при probe означает обращение к регистрам
 * BAM, которое аппаратура не пропускает: блок управляется из TrustZone
 * и его тактирование на этой плате, судя по всему, не поднято к моменту
 * запуска драйвера. Признак qcom,controlled-remotely в msm8917.dtsi
 * уже стоит, но чтение регистров всё равно происходит.
 *
 * BLSP2 на этом устройстве не используется вовсе. Шины BLSP1 (i2c2, i2c3,
 * i2c4, uart2) прекрасно работают без DMA, в режиме прямого ввода-вывода —
 * медленнее, но для тачскрина, топливомера и USB-C это несущественно.
 *
 * Вернуть, когда разберёмся с тактированием BAM.
 */
/*
 * BAM DMA включён.
 *
 * Раньше он был выключен: bam_dma_probe валил ядро внешним прерыванием
 * шины на 0.310 с. Причина оказалась не в самом BAM, а в том, что DTB
 * собирался деревом ядра 6.17, тогда как на устройстве работает 7.1.3.
 * Номера тактовых сигналов между этими версиями разошлись (например,
 * GCC_SDCC1_APPS_CLK: 137 против 122), поэтому драйверы включали и
 * настраивали чужие сигналы — отсюда и отказы шины, и молчащая eMMC.
 *
 * Без BAM драйвер i2c_qup вечно возвращал -EPROBE_DEFER ("tx channel
 * not available"), шины 78b6000/78b7000/78b8000 не поднимались, и
 * тачскрин на 78b7000 не появлялся вовсе.
 */
&blsp1_dma {
	status = "okay";
};

&blsp2_dma {
	status = "okay";
};

