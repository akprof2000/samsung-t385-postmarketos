maintainer="Barnabas Czeman <barnabas.czeman@postmarketos.org>"
_flavor="postmarketos-qcom-msm89x7"
pkgname=linux-postmarketos-qcom-msm89x7
pkgver=7.1.3
pkgrel=55
pkgdesc="Mainline kernel fork for Qualcomm QM215/MSM8917/MSM8937/MSM8940/SDM429/SDM439 devices"
arch="aarch64"
_carch="arm64"
url="https://github.com/msm89x7-mainline/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps
	pmb:cross-native
	pmb:kconfigcheck-nftables
"
makedepends="
	bison
	clang
	elfutils-dev
	findutils
	flex
	linux-headers
	lld
	llvm
	openssl-dev
	pahole
	perl
	postmarketos-installkernel
	python3
	zstd
"
_tag="$pkgver-r1"
_config="config-$_flavor.$arch"
source="
	$pkgname-v$_tag.tar.gz::$url/archive/v$_tag.tar.gz
	$_config
	msm8917-samsung-gta2slte.dts
	gta2slte_wcnss_pronto.dtsi
	0001-stmfts-samsung-fts8-init.patch
	0002-power-add-sm5703-fuelgauge.patch
	0003-panel-s6d7aa0-tv080wxm.patch
	0004-arm64-cpuinfo-model-name.patch
	0005-wcd-analog-lineout.patch
	0006-bam-dmux-legacy-open.patch
	0007-rpmsg-wwan-data40.patch
	0009-media-s5k5e3.patch
	0011-dw9807-vdd-supply.patch
"
builddir="$srcdir/linux-$_tag"

prepare() {
	default_prepare
	cp "$srcdir/config-$_flavor.$arch" .config

	# Samsung Galaxy Tab A 8.0 (2017) LTE (SM-T385, gta2slte).
	# Устройства пока нет в апстриме, поэтому DTS кладём в дерево здесь.
	# Значения в нём сверены со стоковым DTB, снятым с живого планшета.
	cp "$srcdir"/msm8917-samsung-gta2slte.dts \
	   "$srcdir"/gta2slte_wcnss_pronto.dtsi \
	   arch/arm64/boot/dts/qcom/
	grep -q "msm8917-samsung-gta2slte.dtb" arch/arm64/boot/dts/qcom/Makefile || \
		sed -i "/msm8917-xiaomi-riva.dtb/i dtb-\$(CONFIG_ARCH_QCOM)\t+= msm8917-samsung-gta2slte.dtb" \
			arch/arm64/boot/dts/qcom/Makefile
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}
