 	int ret;
 
-	ret = v4l2_ctrl_handler_init(hdl, 6);
+	ret = v4l2_ctrl_handler_init(hdl, 8);
 	if (ret)
 		return ret;
 
@@ -472,6 +472,26 @@
 				       S5K5E3_ANA_GAIN_MAX, 1,
 				       S5K5E3_ANA_GAIN_DEFAULT);
 
+	/*
