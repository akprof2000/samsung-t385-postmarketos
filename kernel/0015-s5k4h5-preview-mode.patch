-static void s5k4h5_update_fmt(struct v4l2_mbus_framefmt *fmt)
+/*
+ * Ближайший режим к запрошенному размеру. Сравниваем по площади: так
+ * предпросмотр не «прыгает» на полный кадр из-за небольшой разницы
+ * в пропорциях.
+ */
+static const struct s5k4h5_mode *s5k4h5_find_mode(u32 width, u32 height)
 {
-	fmt->width = S5K4H5_WIDTH;
-	fmt->height = S5K4H5_HEIGHT;
+	const struct s5k4h5_mode *best = &s5k4h5_modes[0];
+	s64 want = (s64)width * height;
+	s64 diff = S64_MAX;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(s5k4h5_modes); i++) {
+		s64 have = (s64)s5k4h5_modes[i].width * s5k4h5_modes[i].height;
+		s64 d = want > have ? want - have : have - want;
+
+		if (d < diff) {
+			diff = d;
+			best = &s5k4h5_modes[i];
+		}
+	}
+
+	return best;
+}
+
+/* Слепые зоны и экспозиция зависят от выбранного режима. */
+static void s5k4h5_update_ctrls(struct s5k4h5 *s5k)
+{
+	const struct s5k4h5_mode *m = s5k->mode;
+	int exp_max = m->fll - S5K4H5_EXPOSURE_MARGIN;
+
+	__v4l2_ctrl_modify_range(s5k->hblank, m->llp - m->width,
+				 m->llp - m->width, 1, m->llp - m->width);
+	__v4l2_ctrl_modify_range(s5k->vblank, m->fll - m->height,
+				 0xffff - m->height, 1, m->fll - m->height);
+	__v4l2_ctrl_modify_range(s5k->exposure, S5K4H5_EXPOSURE_MIN,
+				 exp_max, 1, exp_max);
+}
+
+static void s5k4h5_update_fmt(struct v4l2_mbus_framefmt *fmt,
+			      const struct s5k4h5_mode *mode)
+{
+	fmt->width = mode->width;
+	fmt->height = mode->height;
 	fmt->code = MEDIA_BUS_FMT_SGRBG10_1X10;
 	fmt->field = V4L2_FIELD_NONE;
 	fmt->colorspace = V4L2_COLORSPACE_RAW;
@@ -408,15 +543,26 @@
 			  struct v4l2_subdev_state *state,
 			  struct v4l2_subdev_format *fmt)
 {
-	s5k4h5_update_fmt(&fmt->format);
+	struct s5k4h5 *s5k = to_s5k4h5(sd);
+	const struct s5k4h5_mode *mode;
+
+	mode = s5k4h5_find_mode(fmt->format.width, fmt->format.height);
+	s5k4h5_update_fmt(&fmt->format, mode);
 	*v4l2_subdev_state_get_format(state, 0) = fmt->format;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE) {
+		s5k->mode = mode;
+		s5k4h5_update_ctrls(s5k);
+	}
+
 	return 0;
 }
 
 static int s5k4h5_init_state(struct v4l2_subdev *sd,
 			     struct v4l2_subdev_state *state)
 {
-	s5k4h5_update_fmt(v4l2_subdev_state_get_format(state, 0));
+	s5k4h5_update_fmt(v4l2_subdev_state_get_format(state, 0),
+			  &s5k4h5_modes[0]);
 	return 0;
 }
 
