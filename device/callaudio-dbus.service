[D-BUS Service]
# Вместо стандартного callaudiod — своя служба. Стандартной нужен
# отдельный режим звуковой карты для разговора, а на этом планшете
# такой режим невозможен: система звука либо молча отбрасывает его,
# либо делает из него негодный выход («no available output found»),
# и кнопки в интерфейсе звонка остаются мёртвыми.
Name=org.mobian_project.CallAudio
Exec=/usr/sbin/t385-callaudiod.py
