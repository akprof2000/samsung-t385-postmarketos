[Unit]
Description=Reinit touchscreen after boot (SM-T385)
# Панель FTS8CD56 иногда просыпается «глухой»: probe цел, прерывание
# включено, но события не идут (в dmesg сыплется error 0x0dec00d0ba).
# Полная перепривязка драйвера лечит это гарантированно.
After=multi-user.target

[Service]
# Namely simple, не oneshot: с oneshot systemd ждал бы завершения всей
# паузы, и multi-user.target (а за ним и графика) приезжал на 12 секунд
# позже. Здесь служба «запущена» сразу, а реинит происходит в фоне.
Type=simple
ExecStart=/bin/sh -c 'sleep 8; echo 3-0049 > /sys/bus/i2c/drivers/stmfts/unbind 2>/dev/null; sleep 1; echo 3-0049 > /sys/bus/i2c/drivers/stmfts/bind'
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
