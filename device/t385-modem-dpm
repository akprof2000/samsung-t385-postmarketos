#!/bin/sh
# SM-T385: (1) прошивка модема не создаёт QMI-канал сама — открываем
# порты через QMI DPM (модем создаёт DATA40_CNTL, ядро отдаёт его как
# wwan-QMI-порт); (2) модем поднимает сигнал готовности BAM-DMUX до
# того, как драйвер начинает слушать — пересобираем драйвер, чтобы он
# перечитал уровень и завершил рукопожатие.
n=0
until timeout 5 qrtr-lookup 2>/dev/null | grep -q "Data Port Mapper"; do
    sleep 3; n=$((n+1)); [ "$n" -gt 40 ] && exit 1
done
ok=1
for try in 1 2 3 4 5; do
    if timeout 25 qmicli -p -d qrtr://0 --dpm-open-port="ctrl-ep-type=bam-dmux,ctrl-ep-iface-number=0,ctrl-port-name=DATA40_CNTL,sw-data-ep-type=bam-dmux,sw-data-ep-iface-number=0,sw-data-port-name=bam_dmux_ch_0" 2>/dev/null | grep -q "Successfully"; then
        ok=0
        break
    fi
    sleep 5
done
sleep 3
D=$(ls /sys/bus/platform/drivers/bam-dmux/ 2>/dev/null | grep dmux | head -1)
if [ -n "$D" ]; then
    echo "$D" > /sys/bus/platform/drivers/bam-dmux/unbind 2>/dev/null
    sleep 1
    echo "$D" > /sys/bus/platform/drivers/bam-dmux/bind 2>/dev/null
fi
exit $ok
