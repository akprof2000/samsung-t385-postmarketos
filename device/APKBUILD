# Reference: <https://postmarketos.org/devicepkg>
# Пакет устройства — Samsung Galaxy Tab A 8.0 (2017) LTE (SM-T385, gta2slte)
#
# Построен по образцу device-qcom-msm89x7 из pmaports, а не по донорскому
# пакету T380: в pmaports уже есть вся инфраструктура msm89x7
# (soc-qcom-msm89x7, linux-postmarketos-qcom-msm89x7, firmware-qcom-msm89x7),
# и опираться на неё правильнее, чем тащить самосборное ядро.
#
# Проприетарные блобы Wi-Fi сняты с живого SM-T385:
#   /system/vendor/firmware/wlan/prima/WCNSS_*
# Калибровка WCNSS_qcom_wlan_nv.bin у каждого экземпляра своя — снимать
# нужно со своего планшета, скриптом tools/Pull-Firmware.ps1.
# Распространять эти файлы нельзя, в репозиторий идёт только рецепт.

pkgname=device-samsung-gta2slte
pkgdesc="Samsung Galaxy Tab A 8.0 (2017) LTE"
pkgver=0.1
pkgrel=32
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-qcom-adreno-a300
	firmware-qcom-msm89x7
	linux-postmarketos-qcom-msm89x7
	lk2nd-msm8952
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom-msm89x7
	soc-qcom-msm89x7-ucm
"
# soc-qcom-msm89x7-ucm нужен потому, что наш HiFi.conf ссылается на
# готовые последовательности codecs/msm8953-wcd/* из этого пакета.
# (Комментарий обязан быть СНАРУЖИ depends= — внутри кавычек '#'
#  не комментарий, а часть строки, и apk примет его за имя пакета.)
makedepends="devicepkg-dev"
# Файл активации на шине принадлежит пакету callaudiod:
# без этого apk откажется его заменять своим.
replaces="callaudiod"

subpackages="
	$pkgname-nonfree-firmware:nonfree_firmware
"

source="
	deviceinfo
	libcamera-configuration.yaml
	modules-initfs
	99-unmanaged-usb0.conf
	WCNSS_qcom_wlan_nv.bin
	WCNSS_cfg.dat
	WCNSS_wlan_dictionary.dat
	WCNSS_qcom_cfg.ini
	ucm-card.conf
	ucm-HiFi.conf
	ucm-VoiceCall.conf
	pulse-nosuspend.pa
	pulse-rate.conf
	t385-audio-wake
	t385-audio-wake.service
	t385-sound-keeper.service
	t385-volblip.py
	t385-volblip.service
	t385-modem-dpm
	t385-modem-dpm.service
	t385-touch-kick.service
	t385-touch-resume.service
	t385-callaudiod.py
	callaudio-dbus.service
	q6voiced-t385.conf
	feedbackd-gta2slte.json
	73-t385-torch.rules
	10-t385-lid.conf
	t385-lid-screen.py
	t385-lid-screen.service
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# usb0 отдаём под отладочный SSH — NetworkManager его не трогает
	install -Dm644 "$srcdir"/99-unmanaged-usb0.conf \
		"$pkgdir"/etc/NetworkManager/conf.d/99-unmanaged-usb0.conf

	# Камера: цвет собирает процессор, а не видеоядро. Путь через
	# видеоядро роняет службу звука и видео, и приложение теряет
	# изображение. Подробности — в самом файле.
	install -Dm644 "$srcdir"/libcamera-configuration.yaml \
		"$pkgdir"/etc/libcamera/configuration.yaml

	# ALSA UCM. Без него PipeWire карту видит, но переключать наушники
	# и микрофоны не умеет. ALSA ищет конфиг по имени карты из &sound,
	# то есть по "samsung-gta2slte".
	install -Dm644 "$srcdir"/ucm-card.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/samsung-gta2slte/samsung-gta2slte.conf
	# Имя драйвера звуковой карты ядро обрезает до 15 символов
	# ("samsung-gta2slt" без последней буквы), а ALSA ищет профиль
	# именно по нему. Без копии под этим именем UCM не находится,
	# и pulseaudio откатывается на stereo-fallback без гарнитуры.
	install -Dm644 "$srcdir"/ucm-card.conf \
		"$pkgdir"/usr/share/alsa/ucm2/conf.d/samsung-gta2slt/samsung-gta2slt.conf
	install -Dm644 "$srcdir"/ucm-HiFi.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Samsung/gta2slte/HiFi.conf
	install -Dm644 "$srcdir"/ucm-VoiceCall.conf \
		"$pkgdir"/usr/share/alsa/ucm2/Samsung/gta2slte/VoiceCall.conf
	install -Dm644 "$srcdir"/pulse-nosuspend.pa \
		"$pkgdir"/etc/pulse/default.pa.d/t385-no-suspend.pa
	install -Dm644 "$srcdir"/pulse-rate.conf \
		"$pkgdir"/etc/pulse/daemon.conf.d/t385-rate.conf
	install -Dm755 "$srcdir"/t385-audio-wake \
		"$pkgdir"/usr/sbin/t385-audio-wake
	install -Dm644 "$srcdir"/t385-audio-wake.service \
		"$pkgdir"/usr/lib/systemd/system/t385-audio-wake.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../t385-audio-wake.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/t385-audio-wake.service
	install -Dm644 "$srcdir"/t385-sound-keeper.service \
		"$pkgdir"/usr/lib/systemd/user/t385-sound-keeper.service
	mkdir -p "$pkgdir"/usr/lib/systemd/user/default.target.wants
	ln -s ../t385-sound-keeper.service \
		"$pkgdir"/usr/lib/systemd/user/default.target.wants/t385-sound-keeper.service
	install -Dm644 "$srcdir"/t385-volblip.py \
		"$pkgdir"/usr/sbin/t385-volblip.py
	install -Dm644 "$srcdir"/t385-volblip.service \
		"$pkgdir"/usr/lib/systemd/system/t385-volblip.service
	ln -s ../t385-volblip.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/t385-volblip.service
	install -Dm644 "$srcdir"/10-t385-lid.conf \
		"$pkgdir"/usr/lib/systemd/logind.conf.d/10-t385-lid.conf
	install -Dm644 "$srcdir"/t385-lid-screen.py \
		"$pkgdir"/usr/sbin/t385-lid-screen.py
	install -Dm644 "$srcdir"/t385-lid-screen.service \
		"$pkgdir"/usr/lib/systemd/system/t385-lid-screen.service
	ln -s ../t385-lid-screen.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/t385-lid-screen.service
	install -Dm644 "$srcdir"/t385-touch-kick.service \
		"$pkgdir"/usr/lib/systemd/system/t385-touch-kick.service
	install -Dm644 "$srcdir"/t385-touch-resume.service \
		"$pkgdir"/usr/lib/systemd/system/t385-touch-resume.service
	# Управление звуком разговора: своя служба вместо callaudiod.
	install -Dm755 "$srcdir"/t385-callaudiod.py \
		"$pkgdir"/usr/sbin/t385-callaudiod.py
	install -Dm644 "$srcdir"/callaudio-dbus.service \
		"$pkgdir"/usr/share/dbus-1/services/org.mobian_project.CallAudio.service
	# Разговорный тракт поднимает штатная q6voiced — ей надо
	# указать верный номер голосового потока, иначе микрофон нем.
	install -Dm644 "$srcdir"/q6voiced-t385.conf \
		"$pkgdir"/usr/lib/systemd/system/q6voiced.service.d/10-t385-device.conf
	# У планшета нет индикаторного светодиода: единственный в
	# системе — вспышка камеры. Стандартная схема feedbackd мигает
	# ею на пропущенные уведомления; наша схема — без светодиода.
	install -Dm644 "$srcdir"/feedbackd-gta2slte.json \
		"$pkgdir"/usr/share/feedbackd/themes/samsung,gta2slte.json
	# Вспышка остаётся под кнопкой фонарика и не служит
	# мигалкой уведомлений — см. комментарий в правиле.
	install -Dm644 "$srcdir"/73-t385-torch.rules \
		"$pkgdir"/usr/lib/udev/rules.d/73-t385-torch.rules
	mkdir -p "$pkgdir"/usr/lib/systemd/system/suspend.target.wants
	ln -s ../t385-touch-resume.service \
		"$pkgdir"/usr/lib/systemd/system/suspend.target.wants/t385-touch-resume.service
	ln -s ../t385-touch-kick.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/t385-touch-kick.service
	install -Dm755 "$srcdir"/t385-modem-dpm \
		"$pkgdir"/usr/sbin/t385-modem-dpm
	install -Dm644 "$srcdir"/t385-modem-dpm.service \
		"$pkgdir"/usr/lib/systemd/system/t385-modem-dpm.service
	ln -s ../t385-modem-dpm.service \
		"$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/t385-modem-dpm.service
	# hkdm монопольно захватывал устройства ввода — кнопки
	# громкости не доходили до оболочки; маскируем
	mkdir -p "$pkgdir"/etc/systemd/system
	ln -s /dev/null "$pkgdir"/etc/systemd/system/hkdm.service
}

nonfree_firmware() {
	pkgdesc="Wi-Fi firmware and per-device calibration for WCN3660B"
	depends="wcnss-wlan"
	mkdir "$subpkgdir"

	# Без калибровки WCN3660B не поднимется: NV-данные привязаны
	# к конкретному экземпляру планшета.
	install -Dm644 "$srcdir"/WCNSS_qcom_wlan_nv.bin \
		"$subpkgdir"/lib/firmware/postmarketos/wlan/prima/WCNSS_qcom_wlan_nv.bin
	install -Dm644 "$srcdir"/WCNSS_cfg.dat \
		"$subpkgdir"/lib/firmware/postmarketos/wlan/prima/WCNSS_cfg.dat
	install -Dm644 "$srcdir"/WCNSS_wlan_dictionary.dat \
		"$subpkgdir"/lib/firmware/postmarketos/wlan/prima/WCNSS_wlan_dictionary.dat
	install -Dm644 "$srcdir"/WCNSS_qcom_cfg.ini \
		"$subpkgdir"/lib/firmware/postmarketos/wlan/prima/WCNSS_qcom_cfg.ini
}

