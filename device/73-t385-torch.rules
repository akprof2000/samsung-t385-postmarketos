# SM-T385: вспышка камеры — единственный светодиод в системе.
#
# Правила feedbackd (72-feedbackd.rules) забирают любой светодиод с
# именем *:torch под индикацию уведомлений: помечают его и запускают
# fbd-ledctrl, который включает триггер "pattern". Беда в том, что эти
# правила срабатывают на КАЖДОЕ событие светодиода, включая изменение
# яркости, а установка триггера в ядре гасит светодиод. Получается
# самоблокировка: кнопка фонарика зажигает свет, тут же прилетает
# событие, триггер переустанавливается — и свет гаснет через доли
# секунды.
#
# Поэтому: у нашей вспышки снимаем пометку feedbackd и очищаем
# очередь его команд (RUN=""), а свою настройку делаем ровно один раз,
# при появлении устройства. Права отдаём группе feedbackd — в ней
# состоит пользователь, от которого работает оболочка.
SUBSYSTEM=="leds", DEVPATH=="*/*:torch", ENV{FEEDBACKD_TYPE}="", RUN=""

ACTION=="add", SUBSYSTEM=="leds", DEVPATH=="*/*:torch", \
  RUN+="/bin/sh -c 'echo none > /sys%p/trigger; chgrp feedbackd /sys%p/brightness; chmod 0664 /sys%p/brightness'"
